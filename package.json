{
  "name": "@instacks/peak",
  "version": "1.3.2",
  "description": "A CSS-first layer on Blades CSS (a Pico CSS fork): a few --peak-* inputs generate an accessible OKLCH palette, fluid type and spacing, with layouts and components built on native popovers, dialogs, details and anchor positioning.",
  "keywords": [
    "css",
    "css-framework",
    "pico",
    "picocss",
    "blades",
    "semantic-html",
    "classless",
    "oklch",
    "light-dark",
    "dark-mode",
    "design-tokens",
    "popover",
    "anchor-positioning",
    "cascade-layers"
  ],
  "homepage": "https://instacks.github.io/peak/",
  "bugs": {
    "url": "https://github.com/instacks/peak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instacks/peak.git"
  },
  "license": "MIT",
  "author": "Futural UG (haftungsbeschränkt)",
  "main": "dist/peak.min.css",
  "style": "dist/peak.min.css",
  "exports": {
    ".": "./dist/peak.min.css",
    "./unminified": "./dist/peak.css",
    "./scoped": "./dist/peak.scoped.min.css",
    "./scoped/unminified": "./dist/peak.scoped.css",
    "./scheme": "./dist/peak-scheme.js",
    "./tokens.json": "./tokens.json",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "sideEffects": [
    "*.css",
    "./dist/peak-scheme.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "build:css": "lightningcss --bundle --browserslist src/peak.css -o dist/peak.css",
    "build:min": "lightningcss --bundle --minify --browserslist src/peak.css -o dist/peak.min.css",
    "build:scoped": "node scripts/build-scoped.mjs",
    "build:js": "node -e \"require('fs').cpSync('src/js/peak-scheme.js', 'dist/peak-scheme.js')\"",
    "build": "npm run tokens && npm run build:css && npm run build:min && npm run build:scoped && npm run build:js",
    "test": "node scripts/tokens.mjs --check && npm run build:css && npm run build:min && npm run build:scoped && npm run build:js && node --test \"test/*.test.mjs\"",
    "watch": "node --watch-path=src --watch-preserve-output scripts/watch.mjs",
    "serve": "python3 -m http.server 8000 --bind 0.0.0.0",
    "docs": "node scripts/docs.mjs",
    "docs:serve": "python3 -m http.server 8001 --bind 0.0.0.0 --directory _site",
    "prepublishOnly": "npm run build",
    "update:upstream": "npm update @sveti/blades && npm run build"
  },
  "devDependencies": {
    "@sveti/blades": "~3.1.4",
    "lightningcss-cli": "1.33.0"
  },
  "allowScripts": {
    "lightningcss-cli@1.33.0": true
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 128",
    "safari >= 18",
    "ios_saf >= 18"
  ]
}
